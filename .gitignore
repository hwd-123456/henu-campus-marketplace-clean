# =============================================================================
# Git Ignore Configuration for CampusCart
# =============================================================================

# Video Files & Large Media (Do not upload to Git repo)
*.mp4
*.webm
*.mov
*.avi
*.mkv
media/
recordings/

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build Outputs & Bundles
dist/
build/
out/
.cache/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# tests  (bare rule removed 2026-10-14: it also ignored backend/tests; use specific paths if needed)
.venv
scratch/
PRESENTATION_DECK.md
*.pptx

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
*.db

# =============================================================================
# Multi-Agent Collaboration (repo-specific rule, 2026-10-14):
# - .orca is NEVER versioned (local-only coordination state)
# - Other agent config folders (.claude/.codex/.opencode/.pi/.agents/.codegraph)
#   ARE versioned on local-only agent branches (ZX466/*, never pushed).
#   On the main worktree they stay untracked via .git/info/exclude so pushed
#   branches never contain them.
# =============================================================================
.orca/
.agent/
# Runtime artifacts inside agent folders (tracked folders stay clean)
.codegraph/*.db-shm
.codegraph/*.db-wal
.codegraph/daemon.log
.codegraph/daemon.pid

# Test-only env files
backend/.env.test
